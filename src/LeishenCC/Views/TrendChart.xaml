<UserControl x:Class="LeishenCC.Views.TrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Canvas x:Name="Plot" Grid.Row="0" Height="178" Background="Transparent" />
        <WrapPanel x:Name="Legend" Grid.Row="1" Margin="0,8,0,0" />
    </Grid>
</UserControl>
