<UserControl x:Class="LeishenCC.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <StackPanel>
        <TextBlock Text="接口诊断" Style="{StaticResource H1}" />
        <TextBlock Text="直接向 root\wmi:RW_GMWMI 送 32 字节命令，逆向时用来验证命令码。数字按十六进制解析。"
                   Style="{StaticResource Body}" Margin="0,4,0,18" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="原始命令" Style="{StaticResource H2}" FontSize="14" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="a0" Style="{StaticResource Caption}" /><TextBox x:Name="InA0" Style="{StaticResource Input}" Text="FA00" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="a1" Style="{StaticResource Caption}" /><TextBox x:Name="InA1" Style="{StaticResource Input}" Text="0200" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="a2" Style="{StaticResource Caption}" /><TextBox x:Name="InA2" Style="{StaticResource Input}" Text="0" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="a3" Style="{StaticResource Caption}" /><TextBox x:Name="InA3" Style="{StaticResource Input}" Text="0" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="a4" Style="{StaticResource Caption}" /><TextBox x:Name="InA4" Style="{StaticResource Input}" Text="0" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="10"><TextBlock Text="a5" Style="{StaticResource Caption}" /><TextBox x:Name="InA5" Style="{StaticResource Input}" Text="0" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="12"><TextBlock Text="a6" Style="{StaticResource Caption}" /><TextBox x:Name="InA6" Style="{StaticResource Input}" Text="0" Margin="0,4,0,0" /></StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="发送" Style="{StaticResource AccentButton}" Click="Send_Click" />
                    <Button Content="读取温度" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Tag="FA00,0200,0,0,0,0,0" Click="Preset_Click" />
                    <Button Content="能力查询" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Tag="FA00,0201,0,0,0,0,0" Click="Preset_Click" />
                    <Button Content="硬件状态" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Tag="FA00,0202,0,0,0,0,0" Click="Preset_Click" />
                    <Button Content="风扇控制状态" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Tag="FA00,0206,0,0,0,0,0" Click="Preset_Click" />
                </StackPanel>

                <Border Background="{DynamicResource ControlFill}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                    <TextBlock x:Name="OutText" Text="—" Style="{StaticResource Body}"
                               FontFamily="{StaticResource NumFont}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="调用日志" Style="{StaticResource H2}" FontSize="14" />
                    <Button Content="清空" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" Click="Clear_Click" />
                </Grid>
                <ListBox x:Name="LogList" Margin="0,10,0,0" Height="220" Background="Transparent"
                         BorderThickness="0" Foreground="{DynamicResource TextSecondary}"
                         FontFamily="{StaticResource NumFont}" FontSize="11.5" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
