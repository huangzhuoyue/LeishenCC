<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 深色 -->
    <Color x:Key="ColBg">#FF202020</Color>
    <Color x:Key="ColLayer">#FF272727</Color>
    <SolidColorBrush x:Key="Bg" Color="#FF202020" />
    <SolidColorBrush x:Key="Layer" Color="#FF272727" />
    <SolidColorBrush x:Key="CardFill" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="CardFillHover" Color="#FF333333" />
    <SolidColorBrush x:Key="Border" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="Divider" Color="#FF353535" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF909090" />
    <SolidColorBrush x:Key="Accent" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="AccentFill" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#FF115EA3" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlFill" Color="#FF323232" />
    <SolidColorBrush x:Key="ControlStroke" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="Danger" Color="#FFFF7B7B" />
    <SolidColorBrush x:Key="Success" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="Warn" Color="#FFFCE100" />
    <SolidColorBrush x:Key="ChartGrid" Color="#FF3A3A3A" />
</ResourceDictionary>
