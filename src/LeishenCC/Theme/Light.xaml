<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 浅色 -->
    <SolidColorBrush x:Key="Bg" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Layer" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="CardFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardFillHover" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="Border" Color="#FFE2E2E2" />
    <SolidColorBrush x:Key="Divider" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF767676" />
    <SolidColorBrush x:Key="Accent" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AccentFill" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#FF005BA1" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlStroke" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Danger" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Success" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="Warn" Color="#FF9D5D00" />
