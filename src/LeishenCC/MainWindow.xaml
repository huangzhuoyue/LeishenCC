<Window x:Class="LeishenCC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="雷神控制中心 · 重建版"
        Height="760" Width="1120" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- 不画独立标题栏：系统标题栏隐藏，侧边栏顶栏兼作拖动区，
         窗口控件浮在右上角（标准位置，收起侧边栏时也在）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 侧边栏图标：24x24 描边风格，与 OpenFRP 一样用 16px 栅格 -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 主体：侧边栏 + 内容区，直接占满窗口 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- 左侧导航：仿 OpenFRP 的 Fluent NavigationView（主区 + 分隔线 + 底区） -->
        <Border x:Name="Nav" Grid.Column="0" Width="250" Background="{DynamicResource Layer}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶栏：汉堡按钮 + 标题（对应 NavigationView 的 PaneToggleButton + 标题行） -->
                <Grid x:Name="NavHeader" Grid.Row="0" Height="36" Margin="6,14,8,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCollapse" Width="32" Height="32" Padding="8,0,0,0"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="收起导航栏" Click="Collapse_Click">
                            <Viewbox Width="16" Height="16">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M4 6h16 M4 12h16 M4 18h16" />
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="NavTitle" Text="雷神控制中心" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 主区菜单项 -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="overview" IsChecked="True" Checked="Nav_Checked" ToolTip="概览">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M4 4 H10 V10 H4 Z M14 4 H20 V8 H14 Z M14 11 H20 V20 H14 Z M4 13 H10 V20 H4 Z" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="概览" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavPerf" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="perf" Checked="Nav_Checked" ToolTip="性能模式">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                <Path Style="{StaticResource NavIcon}" Data="M13 2 L6 13 H10 L9 22 L16 11 H12 Z" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="性能模式" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavFan" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="fan" Checked="Nav_Checked" ToolTip="风扇与散热">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M12 3.8 a8.2 8.2 0 1 0 0.01 0 Z M12 6 v6 M12 12 l4.4 2.5 M12 12 l-4.4 2.5 M12 10.4 a1.6 1.6 0 1 0 0.01 0 Z" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="风扇与散热" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavLed" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="led" Checked="Nav_Checked" ToolTip="键盘灯效">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M9.2 18 h5.6 M10.4 21 h3.2 M12 3 a6 6 0 0 1 3.6 10.8 c-.5.4-.8 1-.8 1.6 H9.2 c0-.6-.3-1.2-.8-1.6 A6 6 0 0 1 12 3 Z" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="键盘灯效" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="display" Checked="Nav_Checked" ToolTip="显卡与显示">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                <Path Style="{StaticResource NavIcon}" Data="M3.5 4.5 h17 v11 h-17 Z M8.5 19.5 h7 M12 15.5 v4" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="显卡与显示" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <Border x:Name="NavDivider" Height="1" Background="{DynamicResource Divider}"
                            Margin="16,8,16,8" />
                </StackPanel>

                <!-- 底区（对应 NavigationView 的 FooterMenuItems） -->
                <StackPanel x:Name="NavFooter" Grid.Row="2" Margin="0,4,0,10">
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="system" Checked="Nav_Checked" ToolTip="系统设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M12 8.6 a3.4 3.4 0 1 0 0.01 0 Z M19.4 14.2 a1.6 1.6 0 0 0 .3 1.8 l.1.1 a1.7 1.7 0 1 1 -2.4 2.4 l-.1-.1 a1.6 1.6 0 0 0 -2.7 1.1 v.3 a1.7 1.7 0 1 1 -3.4 0 v-.2 a1.6 1.6 0 0 0 -2.8 -1.1 l-.1.1 a1.7 1.7 0 1 1 -2.4 -2.4 l.1-.1 a1.6 1.6 0 0 0 -1.1 -2.7 h-.3 a1.7 1.7 0 1 1 0 -3.4 h.2 a1.6 1.6 0 0 0 1.1 -2.8 l-.1-.1 a1.7 1.7 0 1 1 2.4 -2.4 l.1.1 a1.6 1.6 0 0 0 2.7 -1.1 v-.3 a1.7 1.7 0 1 1 3.4 0 v.2 a1.6 1.6 0 0 0 2.7 1.1 l.1-.1 a1.7 1.7 0 1 1 2.4 2.4 l-.1.1 a1.6 1.6 0 0 0 1.1 2.7 h.3 a1.7 1.7 0 1 1 0 3.4 h-.2 a1.6 1.6 0 0 0 -1.5 1.1 Z" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="系统设置" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavDiag" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="diag" Checked="Nav_Checked" ToolTip="接口诊断">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                <Path Style="{StaticResource NavIcon}" Data="M8.5 8 L4.5 12 l4 4 M15.5 8 l4 4 -4 4 M14 6 l-4 12" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="接口诊断" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <!-- 状态行：圆点 + EC 状态，收起后只留圆点 -->
                    <Grid x:Name="NavStatusRow" Margin="14,10,14,0">
                        <StackPanel x:Name="NavStatusBox" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="NavStatusDot" Width="8" Height="8"
                                     Fill="{DynamicResource Success}" />
                            <TextBlock x:Name="NavStatusText" Text="EC 已连接" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 主题开关行 -->
                    <Grid x:Name="NavThemeRow" Margin="14,12,14,0">
                        <StackPanel x:Name="NavThemeBox" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource Switch}"
                                          Checked="Theme_Changed" Unchecked="Theme_Changed" />
                            <TextBlock x:Name="NavThemeLabel" Text="深色界面" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LblModel" Text="重建版 · 原生界面" FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="16,10,12,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Style="{StaticResource OverlayScrollViewer}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ContentControl x:Name="Host" Margin="28,36,28,24" />
            </ScrollViewer>

            <Border Grid.Row="1" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0" Padding="20,7">
                <Grid>
                    <TextBlock x:Name="LblStatus" Text="正在连接 EC 接口…" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="LblClock" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- 窗口控件：浮在窗口右上角，不占布局，收起侧边栏时位置不变 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Width="12" Height="12" Stretch="Uniform" Data="M3 12h18"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path x:Name="MaxIcon" Width="12" Height="12" Stretch="Uniform" Data="M4.5 4.5h15v15h-15Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" StrokeLineJoin="Round" />
            </Button>
            <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="关闭"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Width="12" Height="12" Stretch="Uniform" Data="M5 5l14 14M19 5L5 19"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
